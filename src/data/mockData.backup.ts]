export const ZAR_TO_USD_RATE = 0.055; // Approx R18.20 per $1

export function formatPrice(zarAmount: number, currency: 'ZAR' | 'USD'): string {
  if (currency === 'USD') {
    const usd = zarAmount * ZAR_TO_USD_RATE;
    return `$${usd.toFixed(2)}`;
  }
  return `R${Math.round(zarAmount).toLocaleString()}`;
}

export function formatPriceExact(zarAmount: number, currency: 'ZAR' | 'USD'): string {
  if (currency === 'USD') {
    const usd = zarAmount * ZAR_TO_USD_RATE;
    return `$${usd.toFixed(2)}`;
  }
  return `R${zarAmount.toFixed(2)}`;
}

